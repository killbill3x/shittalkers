  <script>
    // Tab switching
    function setTab(tabId, btn) {
      var contents = document.getElementsByClassName('tab-content');
      for (var i = 0; i < contents.length; i++) {
        contents[i].classList.remove('active');
      }
      var buttons = document.getElementsByClassName('nav-btn');
      for (var j = 0; j < buttons.length; j++) {
        buttons[j].classList.remove('active');
      }
      document.getElementById('tab-' + tabId).classList.add('active');
      btn.classList.add('active');
    }

    // Positional filtering
    function filterPos(pos, btn) {
      var pills = document.getElementsByClassName('pos-pill');
      for (var i = 0; i < pills.length; i++) {
        pills[i].classList.remove('active');
      }
      btn.classList.add('active');

      var items = document.getElementsByClassName('pos-item');
      for (var j = 0; j < items.length; j++) {
        if (pos === 'all' || items[j].classList.contains(pos)) {
          items[j].style.display = 'flex';
        } else {
          items[j].style.display = 'none';
        }
      }
    }

    // Secret Triple-Tap Admin Access
    var tapCount = 0;
    var tapTimer = null;
    function triggerSecretAuth() {
      tapCount++;
      clearTimeout(tapTimer);
      tapTimer = setTimeout(function() { tapCount = 0; }, 1200);

      if (tapCount === 3) {
        tapCount = 0;
        var pass = prompt("Commissioner Access: Enter Password");
        if (pass === "commish") {
          document.getElementById('admin-nav-btn').style.display = 'block';
          alert("Commissioner unlocked!");
          setTab('upload', document.getElementById('admin-nav-btn'));
        } else if (pass !== null) {
          alert("Incorrect password.");
        }
      }
    }

    // Image preview
    var currentBase64Image = null;
    function previewScreenshot(event) {
      var file = event.target.files[0];
      if (file) {
        var reader = new FileReader();
        reader.onload = function(e) {
          currentBase64Image = e.target.result;
          var img = document.getElementById('preview-img');
          img.src = currentBase64Image;
          img.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    }

    // Save uploaded proof to LocalStorage
    function processUpload() {
      if (!currentBase64Image) {
        alert("Please choose a screenshot image first.");
        return;
      }
      var yr = document.getElementById('upload-year').value;
      var type = document.getElementById('upload-type').value;
      var notes = document.getElementById('upload-notes').value || 'No notes provided.';

      var newReceipt = {
        year: yr,
        category: type,
        notes: notes,
        image: currentBase64Image,
        dateAdded: new Date().toLocaleDateString()
      };

      var saved = JSON.parse(localStorage.getItem('shittalkers_receipts') || '[]');
      saved.unshift(newReceipt);
      try {
        localStorage.setItem('shittalkers_receipts', JSON.stringify(saved));
        alert("Receipt successfully archived for " + yr + "!");
        document.getElementById('file-picker').value = "";
        document.getElementById('preview-img').style.display = "none";
        document.getElementById('upload-notes').value = "";
        currentBase64Image = null;
        loadReceipts();
      } catch(e) {
        alert("File size too large for local browser memory. Try resizing the screenshot.");
      }
    }

    // Render saved receipts
    function loadReceipts() {
      var container = document.getElementById('receipts-container');
      var saved = JSON.parse(localStorage.getItem('shittalkers_receipts') || '[]');
      if (saved.length === 0) {
